<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tab_overview_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="18dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tabOverviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_overview_title"
            android:textColor="@color/yt_on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/tabOverviewNewTab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/tab_action_button_background"
            android:contentDescription="@string/menu_new_tab"
            android:padding="8dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/yt_primary" />

        <ImageButton
            android:id="@+id/tabOverviewDuplicateCurrent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tab_action_button_background"
            android:contentDescription="@string/menu_duplicate_tab"
            android:padding="8dp"
            android:src="@drawable/ic_tabs_overview"
            app:tint="@color/yt_primary" />

        <ImageButton
            android:id="@+id/tabOverviewCloseOthers"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tab_action_button_background"
            android:contentDescription="@string/tab_overview_close_others"
            android:padding="8dp"
            android:src="@drawable/ic_tabs_close_others"
            app:tint="@color/yt_primary" />

        <ImageButton
            android:id="@+id/tabOverviewClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tab_action_button_background"
            android:contentDescription="@string/tab_overview_close"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/yt_on_surface" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabOverviewList"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />
</LinearLayout>
