{
  "manifest_version": 2,
  "name": "Tube NEXT Nav Switch",
  "version": "1.1",
  "description": "Intercepts YouTube mode-boundary clicks before SPA navigation.",
  "applications": {
    "gecko": {
      "id": "tubenext-nav-switch@shakie.de"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
