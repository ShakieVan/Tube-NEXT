{
  "manifest_version": 2,
  "name": "Tube NEXT Nav Switch",
  "version": "1.31",
  "description": "Handles YouTube mode changes, watch-page tweaks, and link actions for Tube NEXT.",
  "applications": {
    "gecko": {
      "id": "tubenext-nav-switch@shakie.de"
    }
  },
  "background": {
    "scripts": [
      "ryd-background.js"
    ]
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "storage",
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
